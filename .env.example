PORT=3000
NODE_ENV=development

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=book_management
DB_USER=root
DB_PASSWORD=

# Use a long, random value in production. Do not commit the real value.
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=2h

# Optional. For example: https://your-app.onrender.com
CORS_ORIGIN=

# Used only by npm run seed to create a local demonstration account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

